{/* The homepage starts in dark mode; an explicit choice is remembered. */}
<script is:inline>
	(() => {
		const readTheme = () => {
			try { return localStorage.getItem("homepage-theme") === "light" ? "light" : "dark"; }
			catch { return "dark"; }
		};
		const setTheme = (theme) => {
			document.documentElement.dataset.theme = theme;
			document.querySelector('meta[name="theme-color"]')?.setAttribute("content", theme === "dark" ? "#000000" : "#ffffff");
			document.dispatchEvent(new CustomEvent("theme-updated"));
		};
		setTheme(readTheme());
		document.addEventListener("astro:after-swap", () => setTheme(readTheme()));
		document.addEventListener("theme-change", (event) => {
			const theme = event.detail?.theme;
			if (theme !== "light" && theme !== "dark") return;
			try { localStorage.setItem("homepage-theme", theme); } catch {}
			setTheme(theme);
		});
		window.addEventListener("storage", (event) => {
			if (event.key === "homepage-theme" || event.key === null) setTheme(readTheme());
		});
	})();
</script>
