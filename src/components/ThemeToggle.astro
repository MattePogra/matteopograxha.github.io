<theme-toggle>
	<button class="theme-link" type="button" role="switch" aria-checked="false" aria-label="Dark mode">
		<span aria-hidden="true">[ <span data-theme-label>dark mode</span> ]</span>
	</button>
</theme-toggle>

<script>
	class ThemeToggle extends HTMLElement {
		private controller?: AbortController;
		connectedCallback() {
			this.controller?.abort();
			this.controller = new AbortController();
			const { signal } = this.controller;
			const button = this.querySelector("button")!;
			const label = this.querySelector("[data-theme-label]")!;
			const sync = () => {
				const dark = document.documentElement.dataset.theme === "dark";
				button.setAttribute("aria-checked", String(dark));
				label.textContent = dark ? "light mode" : "dark mode";
			};
			sync();
			button.addEventListener("click", () => {
				document.dispatchEvent(new CustomEvent("theme-change", { detail: { theme: document.documentElement.dataset.theme === "dark" ? "light" : "dark" } }));
			}, { signal });
			document.addEventListener("theme-updated", sync, { signal });
		}
		disconnectedCallback() {
			this.controller?.abort();
		}
	}
	if (!customElements.get("theme-toggle")) customElements.define("theme-toggle", ThemeToggle);
</script>
